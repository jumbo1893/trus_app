<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Trusí appka</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>trus_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>NSMotionUsageDescription</key>
    <string>Trusí appka používá rozpoznání fyzické aktivity ke čtení počtu kroků pro vaši osobní historii a volitelnou týmovou výzvu.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Aplikace používá mikrofon pro nadiktování dotazu TrusBotovi.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Aplikace převádí nadiktovaný dotaz pro TrusBota na text.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Trusí appka čte z Apple Health pouze počet kroků. Denní součty používá pro vaši historii, statistiky, týmovou výzvu, žebříček a krokové úspěchy.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Trusí appka používá přístup k Apple Health pouze pro funkci kroků; do Apple Health žádné zdravotní údaje nezapisuje.</string>
    <key>NSPushNotificationsUsageDescription</key>
    <string>Aplikace chce odesílat oznámení o výsledcích zápasů</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
        <string>remote-notification</string>
    </array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.jumbo.trus_app.steps.sync</string>
    </array>
</dict>
</plist>
